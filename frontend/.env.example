# Vercel Serverless Function Proxy Configuration
# These variables are used exclusively server-side by the proxy and are NEVER exposed to client browsers.

# Upstream CloudPilot FastAPI backend URL (must use HTTPS in production, or http://localhost in dev)
BACKEND_URL=https://your-backend.onrender.com

# Server secret API key passed to backend via X-API-Key header
CLOUDPILOT_API_KEY=your-secret-key-here
