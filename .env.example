# Application environment (development | production)
APP_ENV=development

# CloudPilot API Key (minimum 32 characters in production)
CLOUDPILOT_API_KEY=replace-with-a-32-plus-character-secret-key-here

# Development flag to bypass API key requirement (only valid when APP_ENV=development)
DEV_AUTH_DISABLED=false

# Allowed CORS origins (comma-separated; no wildcards in production)
ALLOWED_ORIGIN=http://localhost:5173

# Rate limiting for /api endpoints (requests per minute per client)
RATE_LIMIT_PER_MIN=30

# Simulation limits (CPU allocation modeling)
SIM_MAX_STEPS=1000
SIM_MAX_SERVICES=20
SIM_TIMEOUT_SECONDS=60

# Supabase Postgres integration (optional for initial phase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
